{
    "name": "ticketcheck/nextcloud-ticketcheck",
    "description": "Customer support ticketing system for Nextcloud",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Lara Raffel"
        },
        {
            "name": "Alexander Mäule"
        },
        {
            "name": "Hauke Klünder"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "doctrine/dbal": "^3.9",
        "nextcloud/ocp": "^32.0 || ^33.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.0",
        "symfony/console": "^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "OCA\\Ticketcheck\\": "lib/",
            "OCA\\Helpdesk\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\Ticketcheck\\Tests\\": "tests/",
            "OCP\\": "vendor/nextcloud/ocp/OCP/",
            "NCU\\": "vendor/nextcloud/ocp/NCU/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:mutation:license-l10n": "php tests/Mutation/run-license-l10n-mutations.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
