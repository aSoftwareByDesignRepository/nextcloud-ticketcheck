{
    "name": "ticketcheck/nextcloud-ticketcheck",
    "description": "Customer support ticketing system for Nextcloud",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Lara Raffel"
        },
        {
            "name": "Alexander M\u00e4ule"
        },
        {
            "name": "Hauke Kl\u00fcnder"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "doctrine/dbal": "^3.9",
        "nextcloud/ocp": "^32.0 || ^33.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.0",
        "symfony/console": "^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "OCA\\Ticketcheck\\": "lib/",
            "OCA\\Helpdesk\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\Ticketcheck\\Tests\\": "tests/",
            "OCP\\": "vendor/nextcloud/ocp/OCP/",
            "NCU\\": "vendor/nextcloud/ocp/NCU/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:mutation:license-l10n": "php tests/Mutation/run-license-l10n-mutations.php",
        "test:mutation:customer-duplicate": [
            "php tests/Mutation/run-customer-duplicate-mutations.php"
        ],
        "test:mutation:passwordless-auth": [
            "php tests/Mutation/run-passwordless-auth-mutations.php"
        ],
        "test:mutation:portal-gate": [
            "php tests/Mutation/run-portal-gate-mutations.php"
        ],
        "test:mutation:portal-csrf": [
            "php tests/Mutation/run-portal-csrf-mutations.php"
        ],
        "test:mutation:guest-migration": [
            "php tests/Mutation/run-guest-migration-mutations.php"
        ],
        "test:mutation:guest-outbox": [
            "php tests/Mutation/run-guest-outbox-mutations.php"
        ],
        "test:mutation:guest-device": [
            "php tests/Mutation/run-guest-device-mutations.php"
        ],
        "test:mutation:member-hint": [
            "php tests/Mutation/run-member-hint-mutations.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}