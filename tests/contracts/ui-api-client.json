      "reason"
     ]
    }
   ],
   "mobile": null
  },
  {
   "id": "guest-migration-rollback",
   "param": "uid",
   "description": "Per-uid rollback to the migrated NC account (audited, restores access rows + deletes alias). Wizard rollback button.",
   "errorCodes": [],
   "server": [
    {
     "file": "lib/Controller/GuestMigrationController.php",
