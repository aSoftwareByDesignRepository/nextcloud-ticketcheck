   "id": "staff-comment-update",
   "param": "content+is_internal",
   "description": "Staff comment edit (content) and visibility toggle (is_internal). Web edit dialog sends content; kebab one-click toggles send is_internal as 'true'/'false' parsed via FILTER_VALIDATE_BOOLEAN. Companion sends body/visibility + CAS version. Per-field authz is atomic server-side (MH-A12).",
   "errorCodes": [
    "access_denied",
    "comment_not_found",
    "edit_window_expired",
    "content_required",
    "invalid_selection",
    "version_conflict"
   ],
   "server": [
    {
     "file": "lib/Controller/TicketController.php",
     "needles": [
      "getParam('content'",
      "getParam('is_internal'",
      "FILTER_VALIDATE_BOOLEAN",
      "updateComment("
     ]
    },
    {
     "file": "lib/Controller/CompanionController.php",
     "needles": [
      "getParam('body'",
      "getParam('visibility'",
