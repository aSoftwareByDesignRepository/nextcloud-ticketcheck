      "create.resources",
      "resources",
      "options?.resources"
     ]
    },
    {
     "file": "src/api/client.ts",
     "needles": [
      "resources"
     ]
    },
    {
     "file": "src/types.ts",
     "needles": [
      "resources"
     ]
    }
   ]
