    },
    {
     "file": "js/guest-migration.js",
     "needles": [
      "/api/guests/migration/exempt",
      "uid",
      "exempt"
     ]
    }
   ],
   "mobile": null
  },
  {
   "id": "guest-migration-resolve",
   "param": "uid+resolution+reason",
   "description": "S5 resolution: resolution=abandon records abandoned uid with optional reason; resolution=migrate re-runs the single-guest path. Wizard abandon dialog collects reason.",
   "errorCodes": [],
   "server": [
    {
     "file": "lib/Controller/GuestMigrationController.php",
