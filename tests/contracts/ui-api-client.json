{
 "schemaVersion": 1,
 "appId": "ticketcheck",
 "companionDir": "mobile/ticketcheck",
 "contracts": [
  {
   "id": "requester-create-fields",
   "param": "title+description",
   "description": "Requester create uses server-owned NC identity and no project. Both clients collect title and description; companion requires an automatically generated idempotency header.",
   "errorCodes": ["request_failed", "idempotency_key_required"],
   "server": [
    {"file": "lib/Controller/CustomerPortalController.php", "needles": ["getParam('title'", "getParam('description'", "title_is_required", "description_is_required"]},
    {"file": "lib/Controller/RequesterCompanionController.php", "needles": ["storeTicket()", "requester.create", "idempotency_key_required"]}
   ],
   "web": [
    {"file": "templates/portal/create-ticket.php", "needles": ["name=\"title\"", "name=\"description\""]}
   ],
   "mobile": [
    {"file": "src/screens/RequesterPortalScreen.tsx", "needles": ["field('title'", "field('description'", "create.titleRequired", "create.descriptionRequired", "createRequesterTicket(", "newIdempotencyKey()"]},
    {"file": "src/api/requester.ts", "needles": ["JSON.stringify({ title, description", "X-TC-Idempotency-Key"]}
   ]
  },
  {
   "id": "requester-public-reply",
   "param": "comment",
   "description": "Portal and native requester replies require a nonempty public message; optional attachments travel with the same reply. Internal-note and staff identity inputs are not exposed.",
   "errorCodes": ["request_failed", "idempotency_key_required"],
   "server": [
    {"file": "lib/Controller/CustomerPortalController.php", "needles": ["getParam('comment'", "comment_required"]},
    {"file": "lib/Controller/RequesterCompanionController.php", "needles": ["addReply($id)", "requester.reply."]}
   ],
   "web": [
    {"file": "templates/portal/ticket-detail.php", "needles": ["name=\"comment\""]}
   ],
   "mobile": [
    {"file": "src/screens/RequesterPortalScreen.tsx", "needles": ["field('comment'", "ticket.commentEmpty", "replyToRequesterTicket("]},
    {"file": "src/api/requester.ts", "needles": ["body.append('comment', comment)", "X-TC-Idempotency-Key", "attachments[]"]}
   ]
  },
  {
   "id": "ticket-resources-select",
   "param": "resources",
   "description": "Optional multi-select of enabled resource keys on staff ticket create/edit and companion create. Server validates every key exists+enabled (uniform 422 `fields:{resources}`); portal never binds the param.",
   "errorCodes": [
    "invalid_resource",
    "too_many_resources",
    "invalid_resources"
   ],
   "server": [
    {
     "file": "lib/Service/TicketResourceService.php",
     "needles": [
      "resolveWriteKeys",
      "invalid_resource",
      "too_many_resources"
     ]
    },
    {
     "file": "lib/Controller/TicketController.php",
     "needles": [
      "resolveResourceParam",
      "assignTicketResources"
     ]
    },
    {
     "file": "lib/Service/CompanionTicketService.php",
     "needles": [
      "resolveWriteKeys",
      "invalid_resource",
      "'resources'"
     ]
    }
   ],
   "web": [
    {
     "file": "templates/ticket-form.php",
     "needles": [
      "name=\"resources[]\"",
      "resources"
     ]
    },
    {
     "file": "js/ticket-resources-picker.js",
     "needles": [
      "resources[]",
      "tc-res-listbox",
      "setValues"
     ]
    },
    {
     "file": "templates/parts/settings/resources.php",
     "needles": [
      "ticket-resources",
      "ticketResources"
     ]
    },
    {
     "file": "js/settings-resources.js",
     "needles": [
      "api/settings/ticket-resources",
      "requesttoken"
     ]
    }
   ],
   "mobile": [
    {
     "file": "src/screens/CreateTicketScreen.tsx",
     "needles": [
      "create.resources",
      "resources",
      "options?.resources"
     ]
    },
    {
     "file": "src/api/client.ts",
     "needles": [
      "resources"
     ]
    },
    {
     "file": "src/types.ts",
     "needles": [
      "resources"
     ]
    }
   ]
  },
  {
   "id": "portal-otp-request",
   "param": "email",
   "description": "Public passwordless OTP request + verify: server requires a valid email (uniform 202, never an oracle) and a 6-digit code (uniform INVALID_CODE). Web login page collects both.",
   "errorCodes": [
    "INVALID_CODE"
   ],
   "server": [
    {
     "file": "lib/Controller/PortalAuthController.php",
     "needles": [
      "getParam('email'",
      "getParam('code'",
      "invalidCode"
     ]
    }
   ],
   "web": [
    {
     "file": "templates/portal/login.php",
     "needles": [
      "name=\"email\"",
      "name=\"code\"",
      "data-tc-portal-send",
      "data-tc-portal-verify"
     ]
    },
    {
     "file": "js/portal-login.js",
     "needles": [
      "/portal/auth/otp",
      "/portal/auth/verify",
      "email",
      "code"
     ]
    }
   ],
   "mobile": null
  },
  {
   "id": "guest-migration-door",
   "param": "door",
   "description": "S3 door flip: server requires door in {allowed,refused} + acknowledged=yes + fresh dry-run before refusing NC guest login. Migration wizard provides the acknowledgement checkbox + door button.",
   "errorCodes": [],
   "server": [
    {
     "file": "lib/Controller/GuestMigrationController.php",
     "needles": [
      "getParam('door'",
      "migration_dryrun_required",
      "setDoor"
     ]
    }
   ],
   "web": [
    {
     "file": "templates/guests/migration.php",
     "needles": [
      "tc-ack",
      "data-tc-door",
      "migration_ack"
     ]
    },
    {
     "file": "js/guest-migration.js",
     "needles": [
      "/api/guests/migration/door",
      "acknowledged",
      "door"
     ]
    }
   ],
   "mobile": null
  },
  {
   "id": "guest-migration-exempt",
   "param": "uid+exempt",
   "description": "NC-fallback exemption toggle (US-T05): server requires uid, blocks portal: actors; exempt=1/0. Wizard per-uid exempt/unexempt buttons send both fields.",
   "errorCodes": [],
   "server": [
    {
     "file": "lib/Controller/GuestMigrationController.php",
     "needles": [
