  {
   "id": "comment-move",
   "param": "target+comment_ids+attachment_ids+idempotency",
   "description": "Selective move of comments (with bound attachments) and standalone attachments. Web sends target_ticket_id + comment_ids + attachment_ids + idempotency_key (body or X-TC-Idempotency-Key). Companion sends targetTicketId/commentIds/attachmentIds and a MANDATORY idempotencyKey (offline replays). One ordered [source,target] lock; replay returns the stored receipt, key+payload mismatch is idempotency_conflict.",
   "errorCodes": [
    "invalid_selection",
    "too_many_items",
    "ticket_not_found",
    "ticket_merged",
    "access_denied",
    "comment_deleted",
    "attachment_bound_to_comment",
    "idempotency_conflict",
    "idempotency_key_required"
   ],
   "server": [
    {
     "file": "lib/Controller/TicketController.php",
     "needles": [
      "getParam('target_ticket_id'",
      "getParam('comment_ids'",
      "getParam('attachment_ids'",
      "getParam('idempotency_key'",
      "X-TC-Idempotency-Key"
     ]
    },
    {
     "file": "lib/Controller/CompanionController.php",
     "needles": [
      "optionalPositiveInt('targetTicketId'",
      "idListParam('commentIds'",
      "idListParam('attachmentIds'",
      "idempotency_key_required"
     ]
    }
   ],
