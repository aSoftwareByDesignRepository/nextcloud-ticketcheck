     ]
    }
   ],
   "web": [
    {
     "file": "templates/guests/migration.php",
     "needles": [
      "data-tc-abandon"
     ]
    },
    {
     "file": "js/guest-migration.js",
     "needles": [
      "/api/guests/migration/resolve",
