# Copy to .env and adjust for your Docker dev stack (default: localhost:8081).
# Load before smoke tests:  set -a && source e2e/.env && set +a

E2E_BASE=http://localhost:8081
E2E_LOGIN_URL=${E2E_BASE}/index.php/login

E2E_AGENT_CREATE_TICKET_URL=${E2E_BASE}/apps/ticketcheck/tickets/create
E2E_AGENT_TICKETS_LIST_URL=${E2E_BASE}/apps/ticketcheck/tickets
E2E_AGENT_TICKET_DETAIL_URL=${E2E_BASE}/apps/ticketcheck/tickets/1
E2E_GUEST_CREATE_TICKET_URL=${E2E_BASE}/apps/ticketcheck/portal/tickets/create
E2E_GUEST_PORTAL_HOME_URL=${E2E_BASE}/apps/ticketcheck/portal
E2E_GUEST_EMAIL_PREFS_URL=${E2E_BASE}/apps/ticketcheck/portal/email-preferences
E2E_GUEST_CHANGE_PASSWORD_URL=${E2E_BASE}/apps/ticketcheck/portal/change-password
# Optional: existing ticket owned by the guest user
# E2E_GUEST_TICKET_DETAIL_URL=${E2E_BASE}/apps/ticketcheck/portal/tickets/1

# Guest portal smoke: helpdesk_customers user (global-setup → .auth/guest-storage-state.json)
# Reset locally if needed:
#   docker compose exec -e OC_PASS='…' nextcloud php occ user:resetpassword --password-from-env e2e_guest
E2E_GUEST_USER=e2e_guest
E2E_GUEST_PASSWORD=change-me-local-only
# Optional override path:
# E2E_GUEST_STORAGE_STATE=/abs/path/guest-storage-state.json

E2E_SETTINGS_URL=${E2E_BASE}/apps/ticketcheck/settings

# Option A — programmatic agent login (global-setup writes .auth/storage-state.json):
# E2E_USER=admin
# E2E_PASSWORD=your-dev-password
# (E2E_PASS is accepted as an alias for E2E_PASSWORD)

# Option B — manual login once:
# npm run e2e:auth
# export E2E_STORAGE_STATE="$(pwd)/.auth/storage-state.json"
